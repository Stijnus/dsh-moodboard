{
  "name": "dsh-moodboard",
  "version": "0.2.11",
  "description": "Visual reference moodboard for DeepSeek Harness: drag-and-drop images, tags, notes, and pinned style guides the agent reads before generating UI.",
  "license": "MIT",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "node --check index.js && node --check client.js && node --test test/plugin.test.mjs",
    "pack:check": "npm pack --dry-run"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "moodboard",
    "design",
    "ui",
    "style-guide",
    "agent"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Stijnus/dsh-moodboard.git"
  },
  "homepage": "https://github.com/Stijnus/dsh-moodboard#readme",
  "bugs": {
    "url": "https://github.com/Stijnus/dsh-moodboard/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    },
    "compatibility": {
      "dsh": ">=0.2.1-rc.3 <0.3.0-0"
    },
    "catalog": {
      "summary": {
        "en": "Drop in screenshots, tag and annotate them, pin a style guide, and the agent reads those references before it designs UI.",
        "zh": "\u62d6\u5165\u622a\u56fe\u3001\u6253\u6807\u7b7e\u4e0e\u5907\u6ce8\u3001\u56fa\u5b9a\u98ce\u683c\u6307\u5357\uff0c\u667a\u80fd\u4f53\u5728\u8bbe\u8ba1\u754c\u9762\u524d\u5148\u8bfb\u53d6\u8fd9\u4e9b\u53c2\u8003\u3002"
      },
      "category": "ui"
    }
  },
  "engines": {
    "dsh": ">=0.2.1-rc.3 <0.3.0-0"
  }
}
