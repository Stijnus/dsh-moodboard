{
  "name": "dsh-moodboard",
  "version": "0.3.1",
  "description": "Visual reference moodboard for DeepSeek Harness: capture links, Mobbin and Are.na references, pin a style guide, and turn inspiration into your own UI components.",
  "license": "MIT",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "sources.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "docs/CONTRACT.md",
    "docs/INSPIRATION-WORKFLOW.md"
  ],
  "scripts": {
    "test": "node --check index.js && node --check sources.js && node --check client.js && node --test test/plugin.test.mjs test/sources.test.mjs test/client-import.test.mjs",
    "pack:check": "npm pack --dry-run"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "moodboard",
    "design",
    "ui",
    "style-guide",
    "agent"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Stijnus/dsh-moodboard.git"
  },
  "homepage": "https://github.com/Stijnus/dsh-moodboard#readme",
  "bugs": {
    "url": "https://github.com/Stijnus/dsh-moodboard/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    },
    "compatibility": {
      "dsh": ">=0.2.1-rc.3 <0.3.0-0"
    },
    "catalog": {
      "summary": {
        "en": "Pull references from links, Mobbin and Are.na, pin a style guide, and turn inspiration into your own UI components.",
        "zh": "从链接、Mobbin 与 Are.na 收录参考，固定风格指南，再把灵感转成自己的界面组件。"
      },
      "category": "ui"
    }
  },
  "engines": {
    "dsh": ">=0.2.1-rc.3 <0.3.0-0"
  }
}
